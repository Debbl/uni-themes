{
  "name": "uni-themes",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.4.1",
  "description": "Theme switching for React apps: framework-agnostic core, zero-FOUC inline script, no React 19 script warnings. Works with Next.js, React Router, TanStack Start and Vite.",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "license": "MIT",
  "homepage": "https://github.com/Debbl/uni-themes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/uni-themes.git"
  },
  "bugs": "https://github.com/Debbl/uni-themes/issues",
  "keywords": [
    "theme",
    "dark-mode",
    "color-scheme",
    "react",
    "nextjs",
    "react-router",
    "tanstack-start",
    "next-themes"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./script": "./dist/script.mjs",
    "./core": "./dist/core.mjs",
    "./server": "./dist/server.mjs",
    "./next": "./dist/next.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bumpp": "^12.3.0",
    "happy-dom": "^20.14.5",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
