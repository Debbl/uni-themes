{
  "name": "uni-themes-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for uni-themes: theme switching for React apps and its playgrounds",
  "homepage": "https://github.com/Debbl/best-themes#readme",
  "bugs": "https://github.com/Debbl/best-themes/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/best-themes.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter uni-themes build",
    "test": "pnpm --filter uni-themes test",
    "typecheck": "pnpm -r typecheck",
    "release": "pnpm --filter uni-themes release",
    "dev:next": "pnpm --filter playground-nextjs dev",
    "build:next": "pnpm --filter playground-nextjs build",
    "dev:vite": "pnpm --filter playground-vite dev",
    "build:vite": "pnpm --filter playground-vite build",
    "dev:tanstack": "pnpm --filter playground-tanstack-start dev",
    "build:tanstack": "pnpm --filter playground-tanstack-start build",
    "dev:rr": "pnpm --filter playground-react-router dev",
    "build:rr": "pnpm --filter playground-react-router build",
    "dev:website": "pnpm --filter @apps/website dev",
    "build:website": "pnpm --filter @apps/website build",
    "deploy:website": "pnpm --filter @apps/website deploy"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.1"
}
